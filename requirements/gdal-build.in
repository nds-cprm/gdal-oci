# Bootstrap of the virtualenv in /opt/geosgb/venv (build tools for the GDAL Python bindings + numpy).
# gdal-build.txt is generated from this file, with the hashes of every file of each version on PyPI:
#   docker run --rm -v "$PWD/requirements:/r" -w /r python:3.12-slim sh -c \
#     "pip install -q pip-tools && pip-compile -q --generate-hashes --allow-unsafe --strip-extras -o gdal-build.txt gdal-build.in"
pip==26.2.2
setuptools==84.2.1
wheel==0.48.0
# GDAL bindings built against numpy 2 also run with numpy 1.x (the reverse fails at import).
# Updated by hand (Dependabot ignores numpy): change it here and in pyarrow-build.in, then regenerate both .txt
numpy==2.5.4
